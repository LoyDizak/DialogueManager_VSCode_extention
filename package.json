{
  "name": "dialogue-godot-support",
  "displayName": "Godot Dialogue Manager Enhanced",
  "description": "Powerful VS Code support for Godot 4.x Dialogue Manager, including syntax highlighting, intelligent Godot class and method completion, real-time type checking, go-to-definition, signature help, tag completion, and import path completion.",
  "publisher": "hakubox",
  "version": "0.3.5",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/LoyDizak/DialogueManager_VSCode_extention.git"
  },
  "homepage": "https://github.com/LoyDizak/DialogueManager_VSCode_extention#readme",
  "bugs": {
    "url": "https://github.com/LoyDizak/DialogueManager_VSCode_extention/issues"
  },
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dialogue.removeDialogueIDs",
        "title": "Dialogue: Remove All Dialogue IDs",
        "category": "Dialogue"
      },
      {
        "command": "dialogue.addDialogueIDs",
        "title": "Dialogue: Add IDs to All Dialogue Lines",
        "category": "Dialogue"
      },
      {
        "command": "dialogue.openTagSettings",
        "title": "Dialogue: Open Tag Settings",
        "category": "Dialogue"
      },
      {
        "command": "dialogue.addNewTag",
        "title": "Dialogue: Add New Tag",
        "category": "Dialogue"
      },
      {
        "command": "dialogue.exportJSON",
        "title": "Dialogue: Export Dialogue",
        "category": "Dialogue"
      },
      {
        "command": "dialogue.previewJSON",
        "title": "Dialogue: Preview Dialogue (JSON)",
        "category": "Dialogue"
      },
      {
        "command": "dialogue.copyJSON",
        "title": "Dialogue: Copy Dialogue (JSON)",
        "category": "Dialogue"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "resourceLangId == dialogue",
          "command": "dialogue.removeDialogueIDs",
          "group": "dialogue@1"
        },
        {
          "when": "resourceLangId == dialogue",
          "command": "dialogue.addDialogueIDs",
          "group": "dialogue@2"
        },
        {
          "when": "resourceLangId == dialogue",
          "command": "dialogue.openTagSettings",
          "group": "dialogue@3"
        },
        {
          "when": "resourceLangId == dialogue",
          "command": "dialogue.addNewTag",
          "group": "dialogue@4"
        },
        {
          "when": "resourceLangId == dialogue",
          "command": "dialogue.exportJSON",
          "group": "dialogue@5"
        },
        {
          "when": "resourceLangId == dialogue",
          "command": "dialogue.previewJSON",
          "group": "dialogue@6"
        },
        {
          "when": "resourceLangId == dialogue",
          "command": "dialogue.copyJSON",
          "group": "dialogue@7"
        }
      ],
      "commandPalette": [
        {
          "command": "dialogue.exportJSON",
          "when": "resourceLangId == dialogue"
        },
        {
          "command": "dialogue.previewJSON",
          "when": "resourceLangId == dialogue"
        },
        {
          "command": "dialogue.copyJSON",
          "when": "resourceLangId == dialogue"
        }
      ]
    },
    "configuration": {
      "title": "Dialogue Godot Support",
      "properties": {
        "dialogue.diagnostics.enableCustomTags": {
          "type": "boolean",
          "default": true,
          "description": "Enable custom tag completion"
        },
        "dialogue.diagnostics.metadataCategories": {
          "type": "object",
          "default": {
            "face": {
              "icon": "😊",
              "description": "Expression"
            },
            "se": {
              "icon": "🔊",
              "description": "Audio"
            },
            "bgm": {
              "icon": "🎵",
              "description": "Background music"
            },
            "effect": {
              "icon": "✨",
              "description": "Effect"
            },
            "other": {
              "icon": "🏷️",
              "description": "Other tags"
            }
          },
          "description": "Tag category configuration"
        },
        "dialogue.diagnostics.customTags": {
          "type": "object",
          "default": {
            "happy": {
              "description": "Happy expression",
              "example": "NPC: Hello! [#happy]",
              "category": "face",
              "alias": ["joyful", "cheerful"]
            },
            "sad": {
              "description": "Sad expression",
              "example": "NPC: Sob... [#sad]",
              "category": "face",
              "alias": ["unhappy", "upset"]
            },
            "angry": {
              "description": "Angry expression",
              "example": "NPC: Damn it! [#angry]",
              "category": "face",
              "alias": ["mad", "furious"]
            },
            "surprised": {
              "description": "Surprised expression",
              "example": "NPC: What!? [#surprised]",
              "category": "face",
              "alias": ["surprise", "shocked"]
            },
            "knock_sound": {
              "description": "Knocking sound",
              "example": "NPC: *Knock knock* [#knock_sound]",
              "category": "se",
              "alias": ["knocking"]
            },
            "explosion_sound": {
              "description": "Explosion sound",
              "example": "Boom! [#explosion_sound]",
              "category": "se",
              "alias": ["explosion"]
            },
            "camera_shake": {
              "description": "Camera shake effect",
              "example": "NPC: Prepare to die! [#camera_shake]",
              "category": "effect",
              "alias": ["shake", "jitter"]
            },
            "fade_out": {
              "description": "Fade-out animation",
              "example": "NPC: Goodbye... [#fade_out]",
              "category": "effect",
              "alias": ["fade"]
            }
          },
          "markdownDescription": "Custom tag configuration. Format:\n```json \n{ \"tagName\": { \"description\": \"Description\", \"example\": \"Example\", \"category\": \"Category\", \"alias\": [\"alias1\", \"alias2\"] } }\n```",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "description": "Tag description"
              },
              "example": {
                "type": "string",
                "description": "Usage example"
              },
              "category": {
                "type": "string",
                "description": "Tag category (for example emotion, sound, animation, or camera)"
              }
            },
            "required": [
              "description",
              "category"
            ]
          }
        },
        "dialogue.diagnostics.globalClasses": {
          "type": "array",
          "default": [],
          "description": "Global classes (their name prefixes may be omitted in dialogue)",
          "items": {
            "type": "string"
          },
          "markdownDescription": "Once configured, members can be used directly in dialogue without a class name prefix.\n\nFor example, after configuring `StageManager`, write `{{count}}` instead of `{{StageManager.count}}`.",
          "examples": [
            [
              "StageManager",
              "PlayerState",
              "AudioManager"
            ]
          ]
        },
        "dialogue.diagnostics.globalVariables": {
          "type": "object",
          "default": {},
          "description": "Global variable definitions (supports complex nested types)",
          "patternProperties": {
            "^[a-zA-Z_][a-zA-Z0-9_]*$": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "description": "Variable type (for example String, int, Dictionary, Array, or a custom class name)"
                },
                "comment": {
                  "type": "string",
                  "description": "Variable description"
                },
                "schema": {
                  "type": "object",
                  "description": "Internal structure for complex types (Dictionary only)",
                  "patternProperties": {
                    "^[a-zA-Z_][a-zA-Z0-9_]*$": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "description": "Field type (use ? for optional values, such as String?)"
                        },
                        "comment": {
                          "type": "string"
                        },
                        "schema": {
                          "type": "object",
                          "description": "Nested structure (supports unlimited depth)"
                        },
                        "itemType": {
                          "type": "string",
                          "description": "Array element type (Array only)"
                        }
                      },
                      "required": [
                        "type"
                      ]
                    }
                  }
                },
                "itemType": {
                  "type": "string",
                  "description": "Array element type (Array only)"
                }
              },
              "required": [
                "type"
              ]
            }
          },
          "markdownDescription": "Configure global variables with support for complex nested types.\n\n**Example 1: Simple type**\n```json\n{\n  \"playerName\": {\n    \"type\": \"String\",\n    \"comment\": \"Player name\"\n  }\n}\n```\n\n**Example 2: Nested Dictionary**\n```json\n{\n  \"playerStats\": {\n    \"type\": \"Dictionary\",\n    \"comment\": \"Player stats\",\n    \"schema\": {\n      \"hp\": { \"type\": \"int\", \"comment\": \"Health\" },\n      \"skills\": {\n        \"type\": \"Array\",\n        \"itemType\": \"String\",\n        \"comment\": \"Skill list\"\n      }\n    }\n  }\n}\n```\n\n**Example 3: Optional type**\n```json\n{\n  \"equipment\": {\n    \"type\": \"Dictionary\",\n    \"schema\": {\n      \"weapon\": { \"type\": \"String\" },\n      \"armor\": { \"type\": \"String?\", \"comment\": \"Optional\" }\n    }\n  }\n}\n```"
        },
        "dialogue.diagnostics.strictMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable strict mode: report warnings for all calls that cannot be verified"
        },
        "dialogue.diagnostics.builtInVariables": {
          "type": "object",
          "default": {
            "player": "CharacterBody2D",
            "game": "Game"
          },
          "description": "Type mappings for built-in variables"
        }
      }
    },
    "languages": [
      {
        "id": "dialogue",
        "aliases": [
          "Dialogue",
          "dialogue"
        ],
        "extensions": [
          ".dialogue"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "dialogue",
        "scopeName": "source.dialogue",
        "path": "./syntaxes/dialogue.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "dialogue",
        "path": "./syntaxes/snippets.json"
      }
    ]
  },
  "keywords": [
    "godot",
    "dialogue",
    "game development",
    "gdscript",
    "dialogue manager",
    "dialogue_manager"
  ],
  "tags": [
    "godot",
    "game-dev",
    "dialogue"
  ],
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "clean": "rm -rf out *.vsix",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "package:clean": "npm run clean && npm run compile && npm run package"
  },
  "devDependencies": {
    "@types/vscode": "^1.110.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "esbuild": "^0.27.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
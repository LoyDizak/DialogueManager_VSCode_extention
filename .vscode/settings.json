// Place your settings in this file to overwrite default and user settings.
{
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": [
                    "punctuation.definition.arguments.begin",
                    "punctuation.definition.arguments.end",
                    "punctuation.section.parens"
                ],
                "settings": {
                    "foreground": "#FFD700"
                }
            },
            {
                "scope": [
                    "punctuation.separator",
                    "punctuation.separator.comma"
                ],
                "settings": {
                    "foreground": "#FFD700"
                }
            }
        ]
    },
    "files.exclude": {
        "out": false, // set this to true to hide the "out" folder with the compiled JS files
        "dist": false // set this to true to hide the "dist" folder with the compiled JS files
    },
    "search.exclude": {
        "out": true, // set this to false to include "out" folder in search results
        "dist": true // set this to false to include "dist" folder in search results
    },
    // Turn off tsc task auto detection since we have the necessary tasks as npm scripts
    "js/ts.tsc.autoDetect": "off",
    "dialogue.diagnostics.globalClasses": [
        "StageManager",
        "PlayerState",
        "AudioManager"
    ],
    "dialogue.diagnostics.globalVariables": {
        // Simple types
        "playerName": {
            "type": "String",
            "comment": "Player character name"
        },
        "gold": {
            "type": "int",
            "comment": "Current gold"
        },
        // Object type (supports property access)
        "gameManager": {
            "type": "GameManager",
            "comment": "Game manager singleton"
        },
        // Array type
        "inventoryItems": {
            "type": "Array",
            "comment": "Inventory item list"
        },
        // Complex type
        "playerStats": {
            "type": "Dictionary",
            "comment": "Player stats",
            "schema": {
                "hp": {
                    "type": "int",
                    "comment": "Health"
                },
                "mp": {
                    "type": "int",
                    "comment": "Mana"
                },
                "skills": {
                    "type": "Array",
                    "itemType": "String",
                    "comment": "Skill list"
                },
                "equipment": {
                    "type": "Dictionary",
                    "comment": "Equipment",
                    "schema": {
                        "weapon": {
                            "type": "String",
                            "comment": "Weapon name"
                        },
                        "armor": {
                            "type": "String?",
                            "comment": "Armor (optional)"
                        }
                    }
                }
            }
        },
    }
}
# ============================================
# Node.js dependencies
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================================
# TypeScript build output
# ============================================
out/
dist/
build/
*.js
*.js.map
*.d.ts

# ⚠️ Keep .js configuration files
!webpack.config.js
!rollup.config.js
!jest.config.js
!.eslintrc.js

# ============================================
# VS Code extension-specific files
# ============================================
*.vsix                    # Packaged extension files
.vscode-test/             # Generated by the test runner
.vscode-test-web/

# ============================================
# Editors and IDEs
# ============================================
.vscode/                  # VS Code configuration (optional; keep for team sharing)
.idea/                    # JetBrains IDE
*.swp                     # Vim
*.swo
*~

# ⚠️ To share VS Code configuration, use:
# .vscode/*
# !.vscode/settings.json
# !.vscode/tasks.json
# !.vscode/launch.json
# !.vscode/extensions.json

# ============================================
# Operating system files
# ============================================
.DS_Store                 # macOS
Thumbs.db                 # Windows
Desktop.ini
$RECYCLE.BIN/

# ============================================
# Test coverage
# ============================================
coverage/
.nyc_output/
*.lcov

# ============================================
# Environment variables and secrets
# ============================================
.env
.env.local
.env.*.local
secrets.json

# ============================================
# Log files
# ============================================
logs/
*.log
lerna-debug.log*

# ============================================
# Temporary files
# ============================================
tmp/
temp/
*.tmp
*.temp
.cache/

# ============================================
# Packaging and publishing
# ============================================
*.tgz
*.tar.gz

# ============================================
# TypeScript cache
# ============================================
*.tsbuildinfo
.tscache/

# ============================================
# ESLint cache
# ============================================
.eslintcache

# ============================================
# Prettier cache
# ============================================
.prettiercache

# ============================================
# Backup files
# ============================================
*.bak
*.backup
*.old

# ============================================
# Project-specific files (adjust as needed)
# ============================================
